{
    "app-name": "MHCquant",
    "github-user": "OpenMS",
    "version": "1.0.0",
    "repository-name": "mhcquant-app",
    "app_url": "http://localhost:8503",
    "analytics": {
        "google-analytics": {
            "enabled": false,
            "tag": ""
        },
        "piwik-pro": {
            "enabled": false,
            "tag": ""
        },
        "matomo": {
            "enabled": true,
            "url": "https://cdn.matomo.cloud/openms.matomo.cloud",
            "tag": "yDGK8bfY"
        }
    },
    "online_deployment": false,
    "enable_workspaces": true,
    "test": true,
    "workspaces_dir": "..",
    "toppview_shared_exports": "/shared-exports",
    "toppview_lite_url": "https://abi-services.cs.uni-tuebingen.de/toppview-lite/",
    "queue_settings": {
        "default_timeout": 7200,
        "result_ttl": 86400
    },
    "demo_workspaces": {
        "enabled": true,
        "source_dirs": [
            "example-data/workspaces"
        ]
    },
    "max_threads": {
        "local": 4,
        "online": 2
    }
}